{
    "name": "pouya1364/probabilistic-laravel",
    "description": "Laravel package integration for probabilistic-php — Bloom Filter, Counting Bloom Filter, Cuckoo Filter, Count-Min Sketch, and HyperLogLog via the service container and a Facade.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "bloom-filter", "probabilistic-data-structures"],
    "authors": [
        {
            "name": "pouya1364",
            "email": "pouya1364@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "pouya1364/probabilistic-php": "^0.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {"ProbabilisticLaravel\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"ProbabilisticLaravel\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProbabilisticLaravel\\ProbabilisticServiceProvider"
            ],
            "aliases": {
                "Probabilistic": "ProbabilisticLaravel\\Facades\\Probabilistic"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
